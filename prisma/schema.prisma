generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TransactionActivity {
  id           String   @id @default(cuid())
  wallet       String
  counterparty String
  direction    String
  amount       String
  txHash       String
  eventKey     String   @unique
  status       String
  blockNumber  String?
  createdAt    DateTime @default(now())
  aiConfidence Int?
  aiReason     String?
  aiVerdict    String?

  @@index([wallet])
  @@index([counterparty])
  @@index([txHash])
  @@index([createdAt])
  @@index([wallet, createdAt])
}

model SharedProfile {
  id         String   @id @default(cuid())
  wallet     String
  shareId    String   @unique
  score      Int
  label      String
  trend      String
  summary    String
  visibility String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WalletSyncState {
  id               String   @id @default(cuid())
  wallet           String   @unique
  lastScannedBlock String
  updatedAt        DateTime @updatedAt
}

model WalletBalanceSnapshot {
  id        String   @id @default(cuid())
  wallet    String   @unique
  balance   String
  updatedAt DateTime @updatedAt
}
